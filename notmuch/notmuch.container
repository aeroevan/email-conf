# Quadlet: notmuch mail indexer for the shared maildir-data volume
#
# Install:
#   1. podman build -t local/email-notmuch:latest -f notmuch/Containerfile notmuch/
#   2. make install
#      (fills in the @REPO@ and @RUN_DIR@ paths below, copies this file to
#       ~/.config/containers/systemd/ and runs daemon-reload; the [Install]
#       section enables the unit -- "systemctl enable" of a generated quadlet
#       unit is not possible)
#
# Search:  podman exec notmuch sh -c 'cd /var/mail && notmuch search date:today'

[Unit]
Description=notmuch mail indexer
After=mbsync.service network-online.target
Wants=network-online.target

[Container]
ContainerName=notmuch
Image=local/email-notmuch:latest
Volume=maildir-data:/var/mail
Volume=@REPO@/notmuch/notmuchrc:/etc/notmuch/config:ro,z
Volume=@REPO@/notmuch/hooks:/etc/notmuch/hooks:ro,z

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
