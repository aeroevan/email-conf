# Quadlet: pizauth OAuth2 token daemon (rootless systemd user unit)
#
# Install:
#   1. podman build -t local/email-pizauth:latest -f pizauth/Containerfile pizauth/
#   2. Edit pizauth/pizauth.conf (client_id, client_secret, login_hint)
#   3. make install
#      (fills in the @REPO@ and @RUN_DIR@ paths below, copies this file to
#       ~/.config/containers/systemd/ and runs daemon-reload; the [Install]
#       section enables the unit -- "systemctl enable" of a generated quadlet
#       unit is not possible)
#   4. podman exec pizauth pizauth refresh aeroevan@gmail.com
#      # opens OAuth flow via printed URL
#
# The /run/pizauth bind mount is shared with the msmtp container so that the
# pizauth unix socket is reachable from there.

[Unit]
Description=pizauth OAuth2 token daemon
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=pizauth
Image=local/email-pizauth:latest
Volume=@RUN_DIR@:/run/pizauth:z
Volume=@REPO@/pizauth/pizauth.conf:/etc/pizauth/pizauth.conf:ro,z
Volume=pizauth-data:/var/lib/pizauth:z
PublishPort=127.0.0.1:18080:8080

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
