# Quadlet: msmtp mail submission via pizauth OAuth2 (rootless systemd user unit)
#
# Install:
#   1. podman build -t local/email-msmtp:latest -f msmtp/Containerfile msmtp/
#   2. Edit msmtp/msmtp.conf (host, from, user)
#   3. make install
#      (fills in the @REPO@ and @RUN_DIR@ paths below, copies this file to
#       ~/.config/containers/systemd/ and runs daemon-reload; the [Install]
#       section enables the unit -- "systemctl enable" of a generated quadlet
#       unit is not possible)
#
# Mail is sent by piping to the container:
#   echo "body" | podman exec -i msmtp msmtpq -C /etc/msmtprc -t rcpt@example.com
# Anything that fails to send is queued in the msmtp-data volume and retried
# by the container's flush loop.

[Unit]
Description=msmtp mail submission (pizauth OAuth2)
After=pizauth.service network-online.target
Wants=network-online.target

[Container]
ContainerName=msmtp
Image=local/email-msmtp:latest
Volume=@RUN_DIR@:/run/pizauth:z
Volume=@REPO@/msmtp/msmtp.conf:/etc/msmtprc:ro,z
Volume=msmtp-data:/root/.msmtp:z

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
